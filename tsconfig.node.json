{
  "include": ["electron.vite.config.*", "web.vite.config.*", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/web/**/*"],
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "out",
    "types": ["node"]
  }
}
